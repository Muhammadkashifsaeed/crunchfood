# Postgres connection string for your hosted database (e.g. Neon, Railway, RDS).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# OpenAI API key used by the /api/chat route (the "Crispy" product assistant).
OPENAI_API_KEY="sk-..."

# Optional — defaults to gpt-4o-mini if unset.
OPENAI_MODEL="gpt-4o-mini"
